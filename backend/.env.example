# MongoDB Atlas M0 connection string
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/sealms?retryWrites=true&w=majority
MONGODB_DB_NAME=sealms

# Stateless JWT signing secret (at least 32 random bytes, hex or base64)
JWT_SECRET=change-me-to-a-64-char-hex-secret

# AES-256-GCM encryption key for Pterodactyl ptlc_ keys (exactly 64 hex chars = 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upstash Redis (optional for local dev; falls back to in-memory limiter if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public base URL for invite links
PUBLIC_BASE_URL=https://mcsealms.vercel.app

# Local dev port
PORT=3000
